AimPrimary(heading, pitch)
{
	Aiming_3 = 1;
	while( Busy_5 )
	{
		sleep 100;		//350
	}
	if( !Open_1 )
	{
		Busy_5 = 1;
		move head to y-axis [-0] now;
		move larm to y-axis [0] now;
		move flash to z-axis [-0.10] now;
		turn torso to x-axis <0> now;
		turn torso to x-axis <-3.52> speed <27.04>;   //2x
		turn ruparm to x-axis <0> now;
		turn ruparm to x-axis <17.58> speed <135.24>;
		turn rarm to x-axis <0> now;
		turn rarm to x-axis <-65.75> speed <505.82>;
		sleep 130;
		turn torso to x-axis <-8.79> speed <37.68>;
		turn ruparm to x-axis <-11.60> speed <208.48>;
		turn head to x-axis <-8.44> speed <60.28>;
		turn rarm to x-axis <-97.40> speed <226>;
		sleep 140;
		move gun to y-axis [-1.15] speed [8.84];
		turn torso to x-axis <-2.46> speed <48.68>;
		turn ruparm to x-axis <-46.07> speed <265.08>;
		turn head to x-axis <-4.92> speed <27.04>;
		turn leftshoulder to y-axis <-10.55> speed <81.14>;
		turn luparm to x-axis <-60.84> speed <467.96>;
		turn larm to z-axis <24.96> speed <192>;
		turn lhand to z-axis <24.26> speed <186.64>;
		turn rarm to x-axis <-59.08> speed <294.84>;
		turn gun to x-axis <-45> speed <346.24>;
		sleep 130;
		move leftshoulder to z-axis [1.80] speed [15];
		move luparm to y-axis [-0.40] speed [3.34];
		move larm to y-axis [-0.45] speed [3.74];
		move gun to z-axis [0.75] speed [6.26];
		turn torso to x-axis <-1> speed <11.72>;
		turn ruparm to x-axis <-66.81> speed <172.9>;
		turn head to x-axis <-1.76> speed <26.38>;
		turn leftshoulder to y-axis <-27.08> speed <137.72>;
		turn luparm to x-axis <-89.67> speed <240.28>;
		turn larm to z-axis <34.46> speed <79.1>;
		turn lhand to z-axis <27.43> speed <26.38>;
		turn rarm to x-axis <-23.21> speed <298.9>;
		turn gun to x-axis <-90> speed <375.08>;
		sleep 120;
		move leftshoulder to z-axis [1.85] speed [1.02];
		move luparm to y-axis [-0.45] speed [1.02];
		move larm to y-axis [-0.45] speed [0];
		turn leftshoulder to y-axis <-27.43> speed <7.18>;
		turn luparm to x-axis <-90> speed <7.18>;
		turn larm to z-axis <35.16> speed <14.36>;
		turn lhand to z-axis <43.25> speed <322.94>;
		sleep 49;
		turn sleave to x-axis <45> speed <833.52>;
		sleep 54;
		turn sleave to x-axis <180> speed [6.26];
		sleep 24;
		move barrel to z-axis [3.65] speed [93.58];
		sleep 39;
		move scope to y-axis [-0.65] speed [9.42];
		turn scope to x-axis <-19.34> speed <280.3>;
		sleep 69;
		move scope to y-axis [-1.15] speed [6.76];
		turn scope to x-axis <0> speed <261.36>;
		sleep 83;
		Open_1 = 1;
		Busy_5 = 0;
	}
	signal 2;
	set-signal-mask 0;
	set-signal-mask 2;
	turn torso to y-axis heading speed <210>;
	wait-for-turn torso around y-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	show flash;
	turn rarm to x-axis <-40> speed <200>;
	sleep 150;
	hide flash;
	turn rarm to x-axis <-23> speed <50>;
	return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = flash;
	return (0);
}

QueryPrimary(piecenum)
{
	piecenum = flash;
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = torso;
	return (0);
}

Killed(severity, corpsetype)
{
	hide flash;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode torso type BITMAPONLY | BITMAP1;
		explode gun type BITMAPONLY | BITMAP2;
		explode head type BITMAPONLY | BITMAP3;
		explode hip type BITMAPONLY | BITMAP4;
		explode larm type BITMAPONLY | BITMAP5;
		explode lhand type BITMAPONLY | BITMAP1;
		explode lleg type BITMAPONLY | BITMAP2;
		explode luparm type BITMAPONLY | BITMAP3;
		explode lupleg type BITMAPONLY | BITMAP4;
		explode rarm type BITMAPONLY | BITMAP5;
		explode rleg type BITMAPONLY | BITMAP1;
		explode ruparm type BITMAPONLY | BITMAP2;
		explode rupleg type BITMAPONLY | BITMAP3;
		explode scope type BITMAPONLY | BITMAP4;
		explode sleave type BITMAPONLY | BITMAP5;
		explode barrel type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode torso type SHATTER | BITMAP1;
		explode gun type FALL | BITMAP2;
		explode head type FALL | BITMAP3;
		explode hip type FALL | BITMAP4;
		explode larm type FALL | BITMAP5;
		explode lhand type FALL | BITMAP1;
		explode lleg type FALL | BITMAP2;
		explode luparm type FALL | BITMAP3;
		explode lupleg type FALL | BITMAP4;
		explode rarm type FALL | BITMAP5;
		explode rleg type FALL | BITMAP1;
		explode ruparm type FALL | BITMAP2;
		explode rupleg type FALL | BITMAP3;
		explode scope type FALL | BITMAP4;
		explode sleave type FALL | BITMAP5;
		explode barrel type FALL | BITMAP1;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode torso type SHATTER | BITMAP1;
		explode gun type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
		explode head type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP3;
		explode hip type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP4;
		explode larm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP5;
		explode lhand type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
		explode lleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
		explode luparm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP3;
		explode lupleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP4;
		explode rarm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP5;
		explode rleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
		explode ruparm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
		explode rupleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP3;
		explode scope type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP4;
		explode sleave type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP5;
		explode barrel type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
		return (0);
	}
	explode torso type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode gun type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
	explode head type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP3;
	explode hip type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP4;
	explode larm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP5;
	explode lhand type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
	explode lleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
	explode luparm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP3;
	explode lupleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP4;
	explode rarm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP5;
	explode rleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
	explode ruparm type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
	explode rupleg type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP3;
	explode scope type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP4;
	explode sleave type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP5;
	explode barrel type FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
	return (0);
}