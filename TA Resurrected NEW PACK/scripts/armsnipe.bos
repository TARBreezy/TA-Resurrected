					wait-for-turn gun around x-axis;
				}
				justmoved = FALSE;
			}
			sleep 300;
		}
	}
	return (0);
}

Create()
{
	set ARMORED to 1;
	hide flash;
	Open_1 = 0;
	Moving_2 = 0;
	Aiming_3 = 0;
	Busy_5 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script MotionControl();
	start-script SmokeUnit();
	return (0);
}

StartMoving()
{
	Moving_2 = 1;
	return (0);
}

StopMoving()
{
	Moving_2 = 0;
	return (0);
}

RestoreAfterDelay()
{
	sleep 30000;
	set-signal-mask 0;
	Aiming_3 = 0;
	Busy_5 = 1;
	turn torso to y-axis <0> speed <200>;
//	if( Open_1 )
