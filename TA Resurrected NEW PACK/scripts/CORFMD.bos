#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, dummy, wedge, drawer;

static-var  Open_1, Busy_2;

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from base;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
	return (0);
}

Create()
{
	set ARMORED to 1;
	dont-shade dummy;
	dont-shade drawer;
	dont-shade dummy;
	dont-shade wedge;
	Open_1 = 0;
	Busy_2 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
	return (0);
}

RestoreAfterDelay()
{
	sleep 15000;
	set-signal-mask 0;
//	if( Open_1 )
//	{
		Open_1 = 0;
		Busy_2 = 1;
			set ARMORED to 1;
			move wedge to x-axis [2.29] now;
			move drawer to y-axis [9.40] now;
			move dummy to x-axis [-2.09] now;
			move dummy to x-axis [0] speed [140];
			sleep 15;
			move drawer to y-axis [0] speed [20];
			sleep 500;
			move wedge to x-axis [0] speed [10];
			sleep 500;
			cache drawer;
			cache dummy;
			cache wedge;
		Busy_2 = 0;
//	}
	return (0);
}

AimPrimary(heading, pitch)
{
	while( Busy_2 )
	{
		sleep 300;
	}
	if( !Open_1 )
	{
		Busy_2 = 1;
			dont-cache drawer;
			dont-cache dummy;
			dont-cache wedge;
			move wedge to x-axis [0] now;
			move wedge to x-axis [2.29] speed [10];
			sleep 500;
			move drawer to y-axis [9.40] speed [20];
//			sleep 500;
			move dummy to x-axis [-2.09] speed [10];
//			sleep 400;
			sleep Rand( 500, 2000 );
			set ARMORED to 0;
		Open_1 = 1;
		Busy_2 = 0;
	}
	signal 2;
	set-signal-mask 0;
	set-signal-mask 2;
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	Busy_2 = 1;
	hide dummy;
	sleep 100;
	move wedge to x-axis [2.29] now;
	move drawer to y-axis [9.40] now;
	move dummy to x-axis [-2.09] now;
	move dummy to x-axis [0.25] speed [391];
	sleep 10;
	move drawer to y-axis [0] speed [40];
	sleep 300;
	show dummy;
	move wedge to x-axis [2.29] now;
	move drawer to y-axis [0] now;
	move drawer to y-axis [9.40] speed [40];
//	move dummy to x-axis [0.25] now;
//	move dummy to x-axis [0.35] speed [10];
//	sleep 300;
	sleep 200;
	move dummy to x-axis [-2.04] speed [20];
	sleep 200;
	Busy_2 = 0;
	return (0);
}

QueryPrimary(piecenum)
{
	piecenum = dummy;
	return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = dummy;
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = base;
	return (0);
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		explode dummy type BITMAPONLY | BITMAP2;
		explode wedge type BITMAPONLY | BITMAP3;
		explode drawer type BITMAPONLY | BITMAP4;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP1;
		explode dummy type BITMAPONLY | BITMAP2;
		explode wedge type FALL | BITMAP3;
		explode drawer type SHATTER | BITMAP4;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode base type BITMAPONLY | BITMAP1;
		explode dummy type BITMAPONLY | BITMAP2;
		explode wedge type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode drawer type SHATTER | BITMAP4;
		return (0);
	}
	explode base type BITMAPONLY | BITMAP1;
	explode dummy type BITMAPONLY | BITMAP2;
	explode wedge type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode drawer type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	return (0);
}