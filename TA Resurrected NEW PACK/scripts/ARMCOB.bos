#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  Base, Turret, Rail, wake1, wake2, wake3, beamflare, missile, missileflare;

static-var  gun_1, gun_3, restore_delay;

// Signal definitions
#define SIG_AIM				2
#define SIG_AIM_2			4
#define SIG_MOVE			8


SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	while( TRUE )
	{
		healthpercent = get HEALTH;
		if( healthpercent < 66 )
		{
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )
			{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from Base;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

Create()
{
	hide missile;
	Set ARMORED to 1;
//	gun_1 = Rail;
//	gun_3 = missile;
	hide beamflare;
	restore_delay = 12000;
	start-script SmokeUnit();
}

RestoreAfterDelay()
{
	sleep restore_delay;
	turn Turret to y-axis <0.000000> speed <25.005495>;
	turn Rail to x-axis <0.000000> speed <12.505495>;
}

StartMoving()
{
	signal SIG_MOVE;
	set-signal-mask SIG_MOVE;
	while( TRUE )
	{
		emit-sfx 2 from wake1;
		emit-sfx 2 from wake2;
		emit-sfx 2 from wake3;
		sleep 300;
	}
}

StopMoving()
{
	signal SIG_MOVE;
}

AimPrimary(heading, pitch)
{
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	turn Turret to y-axis heading speed <50>;
	turn Rail to x-axis <0.000000> - pitch speed <25>;
	wait-for-turn Turret around y-axis;
	wait-for-turn Rail around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	show beamflare;
	sleep 100;
	hide beamflare;
}


AimFromPrimary(piecenum)
{
	piecenum = Rail;
}

QueryPrimary(piecenum)
{
	piecenum = beamflare;
}

AimTertiary(heading, pitch)
{
	signal SIG_AIM_2;
	set-signal-mask SIG_AIM_2;
	sleep 4000;
//	while( !gun_3 )
//	{
//		sleep 250;
//	}
	return (1);
}

FireTertiary()
{
}

QueryTertiary(piecenum)
{
	piecenum = missileflare;
}

SweetSpot(piecenum)
{
	piecenum = Base;
}

Killed(severity, corpsetype)
{
	hide missile;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode Turret type BITMAPONLY | BITMAP1;
		explode Rail type BITMAPONLY | BITMAP2;
		explode Base type BITMAPONLY | BITMAP2;
		explode wake1 type BITMAPONLY | BITMAP1;
		explode wake2 type BITMAPONLY | BITMAP2;
		explode wake3 type BITMAPONLY | BITMAP3;
		explode beamflare type BITMAPONLY | BITMAP4;
		explode missile type BITMAPONLY | BITMAP5;
		explode missileflare type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode Turret type FALL | EXPLODE_ON_HIT | BITMAP1;
		explode Rail type FALL | EXPLODE_ON_HIT | BITMAP2;
		explode Base type BITMAPONLY | BITMAP2;
		explode wake1 type FALL | EXPLODE_ON_HIT | BITMAP1;
		explode wake2 type FALL | EXPLODE_ON_HIT | BITMAP2;
		explode wake3 type FALL | EXPLODE_ON_HIT | BITMAP3;
		explode beamflare type FALL | EXPLODE_ON_HIT | BITMAP4;
		explode missile type FALL | EXPLODE_ON_HIT | BITMAP5;
		explode missileflare type FALL | EXPLODE_ON_HIT | BITMAP1;
		return (0);
	}
	corpsetype = 3;
	explode Turret type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
	explode Rail type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode Base type BITMAPONLY | BITMAP2;
	explode wake1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
	explode wake2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode wake3 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode beamflare type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	explode missile type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
	explode missileflare type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
}
