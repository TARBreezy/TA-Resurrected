		explode beam7	type	FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP2;
		explode beam8	type	FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAP1;
		return(0);
		}
	if (severity <= 50)
		{
		corpsetype = 2;
		explode base	type	BITMAPONLY | BITMAP2;
		explode body	type	BITMAPONLY | BITMAP2;
		explode guna	type	FALL | FIRE | SMOKE | EXPLODE_ON_HIT | BITMAPNUKE;
