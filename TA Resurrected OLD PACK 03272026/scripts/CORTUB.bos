#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  flare1, flare2, flare3, flare4, base, body, lfoot, rfoot,
       lturret, rturret;

static-var  guns_1;

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from body;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
	return (0);
}

StartMoving()
{
	signal 2;
	set-signal-mask 2;
	while( TRUE )
	{
		move lfoot to z-axis [2.5] speed [7.5];
		move lfoot to y-axis [0] speed [3.75];
		move rfoot to z-axis [-2.5] speed [7.5];
		move rfoot to y-axis [0] speed [3.75];
		sleep 375;
		move lfoot to z-axis [0] speed [7.5];
		move rfoot to z-axis [0] speed [7.5];
		move rfoot to y-axis [0.5] speed [3.75];
		sleep 375;
		move lfoot to z-axis [-2.5] speed [7.5];
		move lfoot to y-axis [0] speed [3.75];
		move rfoot to z-axis [2.5] speed [7.5];
		move rfoot to y-axis [0] speed [3.75];
		sleep 375;
		move lfoot to z-axis [0] speed [7.5];
		move lfoot to y-axis [0.5] speed [3.75];
		move rfoot to z-axis [0] speed [7.5];
		sleep 375;
	}
	return (0);
}

StopMoving()
{
	signal 2;
	set-signal-mask 2;
	move lfoot to z-axis [0] speed [3.75];
	move lfoot to y-axis [0] speed [1.875];
	move rfoot to z-axis [0] speed [3.75];
	move rfoot to y-axis [0] speed [1.875];
	return (0);
}

Create()
{
	hide flare1;
	hide flare2;
	hide flare3;
	hide flare4;
	guns_1 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
	return (0);
}

RestoreAfterDelay()
{
	sleep 5000;
	set-signal-mask 0;
	turn body to y-axis <0> speed <90>;
	turn lturret to x-axis <0> speed <45>;
	turn rturret to x-axis <0> speed <45>;
	return (0);
}

AimFromPrimary(piecenum)
{
	if(guns_1 == 0)
	{
		piecenum = flare1;
	}
	if(guns_1 == 1)
	{
		piecenum = flare3;
	}
	if(guns_1 == 2)
	{
		piecenum = flare2;
	}
	if(guns_1 == 3)
	{
		piecenum = flare4;
	}
	return (0);
}

QueryPrimary(piecenum)
{
	if(guns_1 == 0)
	{
		piecenum = flare1;
	}
	if(guns_1 == 1)
	{
		piecenum = flare3;
	}
	if(guns_1 == 2)
	{
		piecenum = flare2;
	}
	if(guns_1 == 3)
	{
		piecenum = flare4;
	}
	return (0);
}

AimPrimary(heading, pitch)
{
	signal 4;
	set-signal-mask 0;
	set-signal-mask 4;
	turn body to y-axis heading speed <225>;
	turn lturret to x-axis ( <0> - pitch ) speed <150>;
	turn rturret to x-axis ( <0> - pitch ) speed <150>;
	wait-for-turn body around y-axis;
	wait-for-turn lturret around x-axis;
	wait-for-turn rturret around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	++guns_1;
	if( guns_1 > 3 )
	{
		guns_1 = 0;
	}
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = body;
	return (0);
}

Killed(severity, corpsetype)
{
	hide flare1;
	hide flare2;
	hide flare3;
	hide flare4;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		explode body type BITMAPONLY | BITMAP2;
		explode lfoot type BITMAPONLY | BITMAP3;
		explode rfoot type BITMAPONLY | BITMAP4;
		explode lturret type BITMAPONLY | BITMAP5;
		explode rturret type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type FALL | BITMAP1;
		explode body type FALL | BITMAP2;
		explode lfoot type FALL | BITMAP3;
		explode rfoot type FALL | BITMAP4;
		explode lturret type FALL | BITMAP5;
		explode rturret type BITMAPONLY | BITMAP1;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode base type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
		explode body type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode lfoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode rfoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode lturret type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
		explode rturret type BITMAPONLY | BITMAP1;
		return (0);
	}
	explode base type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
	explode body type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode lfoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode rfoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	explode lturret type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
	explode rturret type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	return (0);
}