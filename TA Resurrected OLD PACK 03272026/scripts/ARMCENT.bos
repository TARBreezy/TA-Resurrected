#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  rflare1, rflare2, lflare1, lflare2, base, Body, RLeg, LLeg,
       RFoot, LFoot, RTurr, LTurr, RGun, LGun;

static-var  guns_1;

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from Body;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
	return (0);
}

StartMoving()
{
	signal 2;
	set-signal-mask 2;
	while( TRUE )
	{
		turn LLeg to x-axis <40> speed <105>;
		turn RLeg to x-axis <-40> speed <105>;
		sleep 350;
		turn LLeg to x-axis <0> speed <105>;
		turn RLeg to x-axis <0> speed <105>;
		sleep 350;
		turn LLeg to x-axis <-40> speed <105>;
		turn RLeg to x-axis <40> speed <105>;
		sleep 350;
		turn LLeg to x-axis <0> speed <105>;
		turn RLeg to x-axis <0> speed <105>;
		sleep 350;
	}
	return (0);
}

StopMoving()
{
	signal 2;
	set-signal-mask 2;
	turn LLeg to x-axis <0> speed <55>;
	turn RLeg to x-axis <0> speed <55>;
	return (0);
}

Create()
{
	hide rflare1;
	hide rflare2;
	hide lflare1;
	hide lflare2;
	guns_1 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
	return (0);
}

RestoreAfterDelay()
{
	sleep 5000;
	set-signal-mask 0;
	turn Body to y-axis <0> speed <90>;
	turn LTurr to x-axis <0> speed <45>;
	turn RTurr to x-axis <0> speed <45>;
	return (0);
}

AimFromPrimary(piecenum)
{
	if(guns_1 == 0)
	{
		piecenum = rflare1;
	}
	if(guns_1 == 1)
	{
		piecenum = lflare1;
	}
	if(guns_1 == 2)
	{
		piecenum = rflare2;
	}
	if(guns_1 == 3)
	{
		piecenum = lflare2;
	}
	return (0);
}

QueryPrimary(piecenum)
{
	if(guns_1 == 0)
	{
		piecenum = rflare1;
	}
	if(guns_1 == 1)
	{
		piecenum = lflare1;
	}
	if(guns_1 == 2)
	{
		piecenum = rflare2;
	}
	if(guns_1 == 3)
	{
		piecenum = lflare2;
	}
	return (0);
}

AimPrimary(heading, pitch)
{
	signal 4;
	set-signal-mask 0;
	set-signal-mask 4;
	turn Body to y-axis heading speed <225>;
	turn LTurr to x-axis ( <0> - pitch ) speed <150>;
	turn RTurr to x-axis ( <0> - pitch ) speed <150>;
	wait-for-turn Body around y-axis;
	wait-for-turn LTurr around x-axis;
	wait-for-turn RTurr around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	++guns_1;
	if( guns_1 > 3 )
	{
		guns_1 = 0;
	}
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = Body;
	return (0);
}

Killed(severity, corpsetype)
{
	hide rflare1;
	hide rflare2;
	hide lflare1;
	hide lflare2;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		explode Body type BITMAPONLY | BITMAP2;
		explode RTurr type BITMAPONLY | BITMAP3;
		explode LTurr type BITMAPONLY | BITMAP4;
		explode RGun type BITMAPONLY | BITMAP5;
		explode LGun type BITMAPONLY | BITMAP1;
		explode RLeg type BITMAPONLY | BITMAP2;
		explode LLeg type BITMAPONLY | BITMAP3;
		explode RFoot type BITMAPONLY | BITMAP4;
		explode LFoot type BITMAPONLY | BITMAP5;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type SHATTER | BITMAP1;
		explode Body type FALL | BITMAP2;
		explode RTurr type FALL | BITMAP3;
		explode LTurr type FALL | BITMAP4;
		explode RGun type FALL | BITMAP5;
		explode LGun type FALL | BITMAP1;
		explode RLeg type FALL | BITMAP2;
		explode LLeg type FALL | BITMAP3;
		explode RFoot type FALL | BITMAP4;
		explode LFoot type FALL | BITMAP5;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode base type SHATTER | BITMAP1;
		explode Body type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode RTurr type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode LTurr type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode RGun type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
		explode LGun type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
		explode RLeg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode LLeg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode RFoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode LFoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
		return (0);
	}
	explode base type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode Body type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode RTurr type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode LTurr type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	explode RGun type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
	explode LGun type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
	explode RLeg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode LLeg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode RFoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	explode LFoot type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
	return (0);
}