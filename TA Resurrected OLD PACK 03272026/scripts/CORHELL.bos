#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  Body, RBay, LBay, LDom, RDom, 
	   LBDM1, RBDM1, LBDM2, RBDM2, LBDM3, RBDM3, LBDM4, RBDM4,     
	   LDR1, LDR2, LDR3, LDR4, LDR5, LDR6, RDR1, RDR2, RDR3, RDR4, RDR5, RDR6, 
	   RBayDoor4, RBayDoor3, RBayDoor2, RBayDoor1, LBayDoor4, 
       LBayDoor3, LBayDoor2, LBayDoor1, TacNuke, missile, base;

static-var  statechg_DesiredState, statechg_StateChanging, restore_delay, restore_delay2, restore_delay3, gun_1, gun_2, gun_3;		//ready & firing_3 & nuking

// Signal definitions
#define SIG_AIM				2
#define SIG_AIM_2			4
#define SIG_AIM_3			8


SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	while( TRUE )
	{
		healthpercent = get HEALTH;
		if( healthpercent < 66 )
		{
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )
			{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from Body;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

activatescr()
{
//	set ARMORED to 1;
	if( TRUE )
	{
//		turn LBay to z-axis <0.000000> speed <25.005495>;
//		turn RBay to z-axis <0.000000> speed <25.005495>;
		
		turn LBayDoor1 to z-axis <90.00000> speed <50.000000>;
		turn RBayDoor1 to z-axis <-90.00000> speed <50.000000>;
		turn LBayDoor2 to z-axis <90.00000> speed <50.000000>;
		turn RBayDoor2 to z-axis <-90.00000> speed <50.000000>;
		turn LBayDoor3 to z-axis <90.00000> speed <50.000000>;
		turn RBayDoor3 to z-axis <-90.00000> speed <50.000000>;
		turn LBayDoor4 to z-axis <90.00000> speed <50.000000>;
		turn RBayDoor4 to z-axis <-90.00000> speed <50.000000>;
		
		
//		turn LDom to x-axis <-15.00000> speed <25.000000>;		//50
//		turn RDom to x-axis <-15.00000> speed <25.000000>;		//50
		
		sleep 621;
	}
	sleep 31;
}

deactivatescr()
{
	if( TRUE )
	{
		turn LBayDoor1 to z-axis <0.00000> speed <50.000000>;
		turn RBayDoor1 to z-axis <0.00000> speed <50.000000>;
		turn LBayDoor2 to z-axis <0.00000> speed <50.000000>;
		turn RBayDoor2 to z-axis <0.00000> speed <50.000000>;
		turn LBayDoor3 to z-axis <0.00000> speed <50.000000>;
		turn RBayDoor3 to z-axis <0.00000> speed <50.000000>;
		turn LBayDoor4 to z-axis <0.00000> speed <50.000000>;
		turn RBayDoor4 to z-axis <0.00000> speed <50.000000>;
		
//		turn LDom to x-axis <0.00000> speed <25.000000>;
//		turn RDom to x-axis <0.00000> speed <25.000000>;
		
		sleep 512;
	}
	sleep 25;
}


Go()
{
	call-script activatescr();
//	ready = 1;
//	hold = 1;
}

Stop()
{
//	ready = 0;
//	hold = 0;
	call-script deactivatescr();
}

InitState()
{
	statechg_DesiredState = TRUE;
	statechg_StateChanging = FALSE;
}

RequestState(requestedstate, currentstate)
{
	if( statechg_StateChanging )
	{
		statechg_DesiredState = requestedstate;
		return (0);
	}
	statechg_StateChanging = TRUE;
	currentstate = statechg_DesiredState;
	statechg_DesiredState = requestedstate;
	while( statechg_DesiredState != currentstate )
	{
		if( statechg_DesiredState == 0 )
		{
			call-script Go();
			currentstate = 0;
		}
		if( statechg_DesiredState == 1 )
		{
			call-script Stop();
			currentstate = 1;
		}
	}
	statechg_StateChanging = FALSE;
}


Create()
{
	set ARMORED to 1;
	gun_1 = 5;
	gun_2 = 14;
	gun_3 = missile;
//	ready = 0;
//	nuking = 0;
//	firing_3 = 0;
	restore_delay = 10000;
	restore_delay2 = 6000;
	restore_delay3 = 4000;
	call-script InitState();
	start-script SmokeUnit();
}

//SetMaxReloadTime(Func_Var_1)
//{
