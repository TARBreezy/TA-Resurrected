AimTertiary(heading, pitch)
{
//	start-script RequestState(0);
	signal SIG_AIM_3;
	set-signal-mask SIG_AIM_3;
//	nuking = 1;
	turn LBay to z-axis <45.000000> speed <25.005495>;
	turn RBay to z-axis <-45.000000> speed <25.005495>;
	sleep 4000;
	while( !gun_3 )
	{
		sleep 250;
	}
	start-script RestoreAfterDelay3();
	return (1);
}

FireTertiary()
{
//	firing_3 = 1;
	hide missile;
//	turn LBay to z-axis <0.000000> speed <25.005495>;
//	turn RBay to z-axis <0.000000> speed <25.005495>;
	sleep 90000;
//	firing_3 = 0;
	show missile;
}

QueryTertiary(piecenum)
{
	piecenum = missile;
}

SweetSpot(piecenum)
{
	piecenum = Body;
}

Killed(severity, corpsetype)
{
	hide missile;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode missile type BITMAPONLY | BITMAP1;
		explode RBayDoor4 type BITMAPONLY | BITMAP2;
		explode RBayDoor3 type BITMAPONLY | BITMAP3;
		explode RBayDoor2 type BITMAPONLY | BITMAP4;
		explode RBayDoor1 type BITMAPONLY | BITMAP5;
		explode LBayDoor4 type BITMAPONLY | BITMAP1;
		explode LBayDoor3 type BITMAPONLY | BITMAP2;
		explode LBayDoor2 type BITMAPONLY | BITMAP3;
		explode LBayDoor1 type BITMAPONLY | BITMAP4;
		explode RBay type BITMAPONLY | BITMAP5;
		explode LBay type BITMAPONLY | BITMAP1;
		explode LDom type BITMAPONLY | BITMAP2;
		explode RDom type BITMAPONLY | BITMAP3;
		explode Body type BITMAPONLY | BITMAP4;
		explode TacNuke type BITMAPONLY | BITMAP5;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode missile type FALL | BITMAP1;
		explode RBayDoor4 type FALL | BITMAP2;
		explode RBayDoor3 type FALL | BITMAP3;
		explode RBayDoor2 type FALL | BITMAP4;
		explode RBayDoor1 type FALL | BITMAP5;
		explode LBayDoor4 type FALL | BITMAP1;
		explode LBayDoor3 type FALL | BITMAP2;
		explode LBayDoor2 type FALL | BITMAP3;
		explode LBayDoor1 type FALL | BITMAP4;
		explode RBay type FALL | BITMAP5;
		explode LBay type FALL | BITMAP1;
		explode LDom type FALL | BITMAP2;
		explode RDom type FALL | BITMAP3;
		explode Body type BITMAPONLY | BITMAP4;
		explode TacNuke type BITMAPONLY | BITMAP5;
		return (0);
	}
	if( severity <= 99 )
	{
		corpsetype = 3;
		explode missile type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
		explode RBayDoor4 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode RBayDoor3 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode RBayDoor2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode RBayDoor1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
		explode LBayDoor4 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
		explode LBayDoor3 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode LBayDoor2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode LBayDoor1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode RBay type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
		explode LBay type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
		explode LDom type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode RDom type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode Body type BITMAPONLY | BITMAP4;
		explode TacNuke type BITMAPONLY | BITMAP5;
		return (0);
	}
	corpsetype = 3;
	explode missile type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
	explode RBayDoor4 type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode RBayDoor3 type SHATTER | EXPLODE_ON_HIT | BITMAP3;
	explode RBayDoor2 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode RBayDoor1 type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode LBayDoor4 type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode LBayDoor3 type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode LBayDoor2 type SHATTER | EXPLODE_ON_HIT | BITMAP3;
	explode LBayDoor1 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode RBay type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode LBay type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode LDom type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode RDom type SHATTER | EXPLODE_ON_HIT | BITMAP3;
	explode Body type BITMAPONLY | BITMAP4;
	explode TacNuke type BITMAPONLY | BITMAP5;

}
