RestoreAfterDelay()
{
	sleep restore_delay;
//	turn LBayDoor1 to z-axis <0.000000> speed <25.005495>;
//	turn RBayDoor1 to z-axis <0.000000> speed <25.005495>;
//	turn LBayDoor2 to z-axis <0.000000> speed <25.005495>;
//	turn RBayDoor2 to z-axis <0.000000> speed <25.005495>;
//	turn LBayDoor3 to z-axis <0.000000> speed <25.005495>;
//	turn RBayDoor3 to z-axis <0.000000> speed <25.005495>;
//	turn LBayDoor4 to z-axis <0.000000> speed <25.005495>;
//	turn RBayDoor4 to z-axis <0.000000> speed <25.005495>;
//	ready = 0;
	start-script RequestState(1);
}

RestoreAfterDelay2()
{
	sleep restore_delay2;
	turn LDom to x-axis <0.000000> speed <25.005495>;
	turn RDom to x-axis <0.000000> speed <25.005495>;
//	ready = 0;
//	start-script RequestState(1);
}

RestoreAfterDelay3()
{
	sleep restore_delay3;
	turn LBay to z-axis <0.000000> speed <25.005495>;
	turn RBay to z-axis <0.000000> speed <25.005495>;
}

AimPrimary(heading, pitch)
{
	start-script RequestState(0);
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	wait-for-turn LBayDoor1 around z-axis;
	wait-for-turn RBayDoor1 around z-axis;
	wait-for-turn LBayDoor2 around z-axis;
	wait-for-turn RBayDoor2 around z-axis;
	wait-for-turn LBayDoor3 around z-axis;
	wait-for-turn RBayDoor3 around z-axis;
	wait-for-turn LBayDoor4 around z-axis;	
	wait-for-turn RBayDoor4 around z-axis;
	while( !gun_1 )		// !ready && nuking
	{
		sleep 250;
	}
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	++gun_1;
	if( gun_1 > 12 )
	{
		gun_1 = 5;
	}
}

AimFromPrimary(piecenum)
{
	if( gun_1 == 5 )
	{
		piecenum = LBDM1;
	}
	if( gun_1 == 6 )
	{
		piecenum = RBDM1;
	}
	if( gun_1 == 7 )
	{
		piecenum = LBDM2;
	}
	if( gun_1 == 8 )
	{
		piecenum = RBDM2;
	}
	if( gun_1 == 9 )
	{
		piecenum = LBDM3;
	}
	if( gun_1 == 10 )
	{
		piecenum = RBDM3;
	}
	if( gun_1 == 11 )
	{
		piecenum = LBDM4;
	}
	if( gun_1 == 12 )
	{
		piecenum = RBDM4;
	}
}

QueryPrimary(piecenum)
{
	piecenum = gun_1;
}

AimSecondary(heading, pitch)
{
//	start-script RequestState(0);
	signal SIG_AIM_2;
	set-signal-mask SIG_AIM_2;
	turn LDom to x-axis <-15.00000> speed <25.000000>;
	turn RDom to x-axis <-15.00000> speed <25.000000>;
	wait-for-turn LDom around x-axis;
	wait-for-turn RDom around x-axis;
	while( !gun_2 )		// !ready && nuking
	{
		sleep 250;
	}
	start-script RestoreAfterDelay2();
	return (1);
}

