#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  flare1, flare2, flare3, flare4, base, turret, wake1, wake2,
       barrel1, barrel2;

static-var  Gun_1, Gun_2, Reset_3, Busy_4;

RestoreAfterDelay()
{
	sleep 5000;
	if( !Reset_3 )
	{
		turn turret to y-axis <0> speed <35>;
		turn turret to x-axis <0> speed <15>;
		signal 2;
		signal 4;
	}
	Busy_4 = 0;
	return (0);
}

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from base;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
		if( Reset_3 and !Busy_4 )
		{
			Reset_3 = 0;
			Busy_4 = 1;
			start-script RestoreAfterDelay();
		}
	}
	return (0);
}

Create()
{
	hide flare1;
	hide flare2;
	Gun_1 = 1;
	Gun_2 = 1;
	Reset_3 = 0;
	Busy_4 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
	return (0);
}

StartMoving()
{
	signal 8;
	set-signal-mask 8;
	while( TRUE )
	{
		emit-sfx 2 from wake1;
		emit-sfx 2 from wake2;
		sleep 300;
	}
	return (0);
}

StopMoving()
{
	signal 8;
	return (0);
}

AimPrimary(heading, pitch)
{
	signal 2;
	set-signal-mask 2;
	turn turret to y-axis heading speed <145>;
	turn turret to x-axis ( <0> - pitch ) speed <95>;
	wait-for-turn turret around y-axis;
	wait-for-turn turret around x-axis;
	Reset_3 = 1;
	return (1);
}

AimSecondary()
{
	signal 4;
	set-signal-mask 4;
	Reset_3 = 1;
	return (1);
}

FirePrimary()
{
	if( !Gun_1 )
	{
		move barrel1 to z-axis [-2.40] speed [500];
		wait-for-move barrel1 along z-axis;
		move barrel1 to z-axis [0] speed [3];
		show flare1;
		sleep 150;
		hide flare1;
		Gun_1 = 1;
		return (0);
	}
		move barrel2 to z-axis [-2.40] speed [500];
		wait-for-move barrel2 along z-axis;
		move barrel2 to z-axis [0] speed [3];
		show flare2;
		sleep 150;
		hide flare2;
		Gun_1 = 0;
		return (0);
}

FireSecondary()
{
	if( Gun_2 == 1 )
	{
		show flare3;
		sleep 150;
		hide flare3;
		Gun_2 = 2;
		return (0);
	}
		show flare4;
		sleep 150;
		hide flare4;
		Gun_2 = 1;
		return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = turret;
	return (0);
}

QueryPrimary(piecenum)
{
	piecenum = Gun_1;
	return (0);
}

QuerySecondary(Func_Var_1)
{
	if( Gun_2 == 1 )
	{
		Func_Var_1 = 2;
	}
	if( Gun_2 == 2 )
	{
		Func_Var_1 = 3;
	}
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = turret;
	return (0);
}

Killed(severity, corpsetype)
{
	hide flare1;
	hide flare2;
	hide flare3;
	hide flare4;
	hide wake1;
	hide wake2;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		explode turret type BITMAPONLY | BITMAP2;
		explode barrel1 type BITMAPONLY | BITMAP3;
		explode barrel2 type BITMAPONLY | BITMAP4;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP1;
		explode turret type SHATTER | BITMAP2;
		explode barrel1 type FALL | EXPLODE_ON_HIT | BITMAP3;
		explode barrel2 type FALL | EXPLODE_ON_HIT | BITMAP4;
		return (0);
	}
	corpsetype = 3;
	explode base type BITMAPONLY | BITMAP1;
	explode turret type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode barrel1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode barrel2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	return (0);
}