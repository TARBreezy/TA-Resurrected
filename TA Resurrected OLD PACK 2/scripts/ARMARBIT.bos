#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece	base, Body, SiloFlap1, SiloFlap2, SiloFlap3, LED11, LED12, LED13,
		LED21, LED22, LED23, LED31, LED32, LED33, Armor1LD, Armor1RD,
		Armor2LD, Armor2RD, Armor3LD, Armor3RD, missile;

static-var  Open_1, Busy_2;

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from base;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
	return (0);
}

Create()
{
	hide missile;
	hide LED11;
	hide LED21;
	hide LED31;
	hide LED12;
	hide LED22;
	hide LED32;
	hide LED13;
	hide LED23;
	hide LED33;
	dont-shade missile;
	dont-shade SiloFlap1;
	dont-shade SiloFlap2;
	dont-shade SiloFlap3;
	dont-shade LED11;
	dont-shade LED21;
	dont-shade LED31;
	dont-shade LED12;
	dont-shade LED22;
	dont-shade LED32;
	dont-shade LED13;
	dont-shade LED23;
	dont-shade LED33;
	Open_1 = 0;
	Busy_2 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
}

AimPrimary(heading, pitch)
{
	while( Busy_2 )
	{
		sleep 250;
	}
	if( !Open_1 )
	{
		Busy_2 = 1;
		dont-cache SiloFlap1;
		dont-cache SiloFlap2;
		dont-cache SiloFlap3;
		dont-cache LED11;
		dont-cache LED12;
		dont-cache LED13;
		dont-cache LED21;
		dont-cache LED22;
		dont-cache LED23;
		dont-cache LED31;
		dont-cache LED32;
		dont-cache LED33;
		dont-cache missile;
		turn Armor1LD to y-axis <90> speed <40>;
		turn Armor1RD to y-axis <-90> speed <40>;
		turn Armor2LD to y-axis <90> speed <40>;
		turn Armor2RD to y-axis <-90> speed <40>;
		turn Armor3LD to y-axis <90> speed <40>;
		turn Armor3RD to y-axis <-90> speed <40>;
		wait-for-turn Armor3RD around y-axis;
		turn SiloFlap1 to x-axis <-90> speed <20>;
		turn SiloFlap2 to z-axis <-45> speed <10>;
		turn SiloFlap3 to z-axis <45> speed <10>;
		wait-for-turn SiloFlap3 around z-axis;
		show missile;
		move missile to y-axis [15] speed [10];
		sleep 1500;
		show LED11;
		show LED21;
		show LED31;
		sleep 1000;
		show LED12;
		show LED22;
		show LED32;
		sleep 1000;
		show LED13;
		show LED23;
		show LED33;
		sleep 1000;
		wait-for-move missile along y-axis;		
		Open_1 = 1;
		Busy_2 = 0;
	}
	return (1);
}

FirePrimary()
{
	hide missile;
	Busy_2 = 1;
		Open_1 = 0;
		sleep 3000;
		hide LED13;
		hide LED23;
		hide LED33;
		sleep 1000;
		hide LED12;
		hide LED22;
		hide LED32;
		sleep 1000;
		hide LED11;
		hide LED21;
		hide LED31;
		sleep 1000; 
		turn SiloFlap1 to x-axis <0> speed <20>;
		turn SiloFlap2 to z-axis <0> speed <10>;
		turn SiloFlap3 to z-axis <0> speed <10>;
		wait-for-turn SiloFlap3 around z-axis;
		turn Armor1LD to y-axis <0> speed <40>;
		turn Armor1RD to y-axis <0> speed <40>;
		turn Armor2LD to y-axis <0> speed <40>;
		turn Armor2RD to y-axis <0> speed <40>;
		turn Armor3LD to y-axis <0> speed <40>;
		turn Armor3RD to y-axis <0> speed <40>;
		sleep 100;	
		cache SiloFlap1;
		cache SiloFlap2;
		cache SiloFlap3;
		cache LED11;
		cache LED21;
		cache LED31;
		cache LED12;
		cache LED22;
		cache LED32;
		cache LED13;
		cache LED23;
		cache LED33;
		cache missile;
		sleep 50;
	Busy_2 = 0;
}

QueryPrimary(piecenum)
{
	piecenum = missile;
}

SweetSpot(piecenum)
{
	piecenum = Body;
}

Killed(severity, corpsetype)
{
	hide missile;
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		explode Body type BITMAPONLY | BITMAP2;
		explode SiloFlap1 type FALL | BITMAP4;
		explode SiloFlap2 type FALL | BITMAP5;
		explode SiloFlap3 type FALL | BITMAP1;
		explode Armor1LD type FALL | BITMAP1;
		explode Armor1RD type FALL | BITMAP2;
		explode Armor2LD type FALL | BITMAP3;
		explode Armor2RD type FALL | BITMAP4;
		explode Armor3LD type FALL | BITMAP5;
		explode Armor3RD type FALL | BITMAP1;
		explode missile type FALL | BITMAP2;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP1;
		explode Body type BITMAPONLY | BITMAP2;
		explode SiloFlap1 type SHATTER | BITMAP4;
		explode SiloFlap2 type SHATTER | BITMAP5;
		explode SiloFlap3 type SHATTER | BITMAP1;
		explode Armor1LD type SHATTER | BITMAP1;
		explode Armor1RD type SHATTER | BITMAP2;
		explode Armor2LD type SHATTER | BITMAP3;
		explode Armor2RD type SHATTER | BITMAP4;
		explode Armor3LD type SHATTER | BITMAP5;
		explode Armor3RD type SHATTER | BITMAP1;
		explode missile type FALL | BITMAP2;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode base type BITMAPONLY | BITMAP1;
		explode Body type BITMAPONLY | BITMAP2;
		explode SiloFlap1 type SHATTER | BITMAP4;
		explode SiloFlap2 type SHATTER | BITMAP5;
		explode SiloFlap3 type SHATTER | BITMAP1;
		explode Armor1LD type SHATTER | BITMAP1;
		explode Armor1RD type SHATTER | BITMAP2;
		explode Armor2LD type SHATTER | BITMAP3;
		explode Armor2RD type SHATTER | BITMAP4;
		explode Armor3LD type SHATTER | BITMAP5;
		explode Armor3RD type SHATTER | BITMAP1;
		explode missile type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		return (0);
	}
		explode base type BITMAPONLY | BITMAP1;
		explode Body type BITMAPONLY | BITMAP2;
		explode SiloFlap1 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
		explode SiloFlap2 type SHATTER | EXPLODE_ON_HIT | BITMAP5;
		explode SiloFlap3 type SHATTER | EXPLODE_ON_HIT | BITMAP1;
		explode Armor1LD type SHATTER | EXPLODE_ON_HIT | BITMAP1;
		explode Armor1RD type SHATTER | EXPLODE_ON_HIT | BITMAP2;
		explode Armor2LD type SHATTER | EXPLODE_ON_HIT | BITMAP3;
		explode Armor2RD type SHATTER | EXPLODE_ON_HIT | BITMAP4;
		explode Armor3LD type SHATTER | EXPLODE_ON_HIT | BITMAP5;
		explode Armor3RD type SHATTER | EXPLODE_ON_HIT | BITMAP1;
		explode missile type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	return (0);
}