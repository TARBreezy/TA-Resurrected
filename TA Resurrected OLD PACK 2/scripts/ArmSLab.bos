		explode Blink1 type SHATTER | BITMAP4;
		explode Blink2 type SHATTER | BITMAP4;
		return (0);
	}
	if( severity <= 99 )
	{
		corpsetype = 3;
		explode Basis type BITMAPONLY | BITMAP2;
