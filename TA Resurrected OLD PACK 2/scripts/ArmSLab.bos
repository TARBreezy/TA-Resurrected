#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  Basis, r1Klap, r2Klap, r3Klap, l1Klap, l2Klap, l3Klap, r1Sch,
       r2Sch, l1Sch, l2Sch, r1Arm, r2Arm, l1Arm, l2Arm, r1Traeg,
       r2Traeg, l1Traeg, l2Traeg, r1Halt, r2Halt, l1Halt, l2Halt, r1Nano,
       r2Nano, r3Nano, l1Nano, l2Nano, l3Nano, Rotor, r1Spr, r2Spr,
       r3Spr, l1Spr, l2Spr, l3Spr, r1Rot, r2Rot, l1Rot, l2Rot,
       Spitze, r1Blink, r3Blink, l1Blink, l3Blink, Blink1, Blink2;

static-var  Static_Var_1, Static_Var_2, Static_Var_3;

// Signal definitions
#define SIG_ACTIVATE			2


Drehe()
{
	set-signal-mask 4;
	while( TRUE )
	{
		turn Rotor to y-axis <5.000000> speed <30.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <10.000000> speed <27.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <20.000000> speed <21.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <25.000000> speed <12.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <30.000000> speed <8.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <25.000000> speed <8.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <20.000000> speed <12.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <15.000000> speed <18.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <10.000000> speed <21.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <5.000000> speed <27.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-5.000000> speed <30.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-10.000000> speed <27.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-20.000000> speed <21.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-25.000000> speed <12.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-30.000000> speed <8.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-25.000000> speed <8.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-20.000000> speed <12.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-15.000000> speed <18.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-10.000000> speed <21.000000>;
		wait-for-turn Rotor around y-axis;
		turn Rotor to y-axis <-5.000000> speed <27.000000>;
		wait-for-turn Rotor around y-axis;
	}
}

Schliesse()
{
	signal 4;
	turn Rotor to y-axis <0.000000> speed <15.000000>;
	turn r1Halt to y-axis <0.000000> speed <10.000000>;
	turn r2Halt to y-axis <0.000000> speed <10.000000>;
	turn r2Nano to y-axis <0.000000> speed <10.000000>;
	turn l1Halt to y-axis <0.000000> speed <10.000000>;
	turn l2Halt to y-axis <0.000000> speed <10.000000>;
	turn l2Nano to y-axis <0.000000> speed <10.000000>;
	wait-for-turn r1Halt around y-axis;
	move r1Blink to x-axis [0.000000] speed [4.000000];
	move r3Blink to x-axis [0.000000] speed [4.000000];
	move l1Blink to x-axis [0.000000] speed [4.000000];
	move l3Blink to x-axis [0.000000] speed [4.000000];
	turn r1Traeg to z-axis <0.000000> speed <50.000000>;
	turn r2Traeg to z-axis <0.000000> speed <50.000000>;
	turn l1Traeg to z-axis <0.000000> speed <50.000000>;
	turn l2Traeg to z-axis <0.000000> speed <50.000000>;
	turn r1Rot to z-axis <0.000000> speed <50.000000>;
	turn r2Rot to z-axis <0.000000> speed <50.000000>;
	turn l1Rot to z-axis <0.000000> speed <50.000000>;
	turn l2Rot to z-axis <0.000000> speed <50.000000>;
	turn r1Arm to z-axis <0.000000> speed <10.000000>;
	turn r2Arm to z-axis <0.000000> speed <10.000000>;
	turn l1Arm to z-axis <0.000000> speed <10.000000>;
	turn l2Arm to z-axis <0.000000> speed <10.000000>;
	turn r1Halt to z-axis <0.000000> speed <10.000000>;
	turn r2Halt to z-axis <0.000000> speed <10.000000>;
	turn l1Halt to z-axis <0.000000> speed <10.000000>;
	turn l2Halt to z-axis <0.000000> speed <10.000000>;
	sleep 1500;
	turn r1Arm to z-axis <0.000000> speed <30.000000>;
	turn r2Arm to z-axis <0.000000> speed <30.000000>;
	turn l1Arm to z-axis <0.000000> speed <30.000000>;
	turn l2Arm to z-axis <0.000000> speed <30.000000>;
	turn r1Halt to z-axis <0.000000> speed <30.000000>;
	turn r2Halt to z-axis <0.000000> speed <30.000000>;
	turn l1Halt to z-axis <0.000000> speed <30.000000>;
	turn l2Halt to z-axis <0.000000> speed <30.000000>;
	wait-for-turn r1Arm around z-axis;
	turn r1Klap to z-axis <0.000000> speed <20.000000>;
	turn r2Klap to z-axis <0.000000> speed <24.395604>;
	turn r3Klap to z-axis <0.000000> speed <20.000000>;
	turn l1Klap to z-axis <0.000000> speed <20.000000>;
	turn l2Klap to z-axis <0.000000> speed <24.395604>;
	turn l3Klap to z-axis <0.000000> speed <20.000000>;
	wait-for-turn r1Klap around z-axis;
}

Oeffne()
{
	turn r1Klap to z-axis <90.000000> speed <20.000000>;
	turn l1Klap to z-axis <-90.000000> speed <20.000000>;
	sleep 250;
	turn r2Klap to z-axis <90.000000> speed <20.000000>;
	turn l2Klap to z-axis <-90.000000> speed <20.000000>;
	sleep 250;
	turn r3Klap to z-axis <90.000000> speed <20.000000>;
	turn l3Klap to z-axis <-90.000000> speed <20.000000>;
	wait-for-turn l3Klap around z-axis;
	move r1Blink to x-axis [2.000000] speed [4.000000];
	move r3Blink to x-axis [2.000000] speed [4.000000];
	move l1Blink to x-axis [-2.000000] speed [4.000000];
	move l3Blink to x-axis [-2.000000] speed [4.000000];
	turn r1Arm to z-axis <130.000000> speed <20.000000>;
	turn r2Arm to z-axis <130.000000> speed <20.000000>;
	turn r1Halt to z-axis <-130.000000> speed <20.000000>;
	turn r2Halt to z-axis <-130.000000> speed <20.000000>;
	sleep 500;
	turn l1Arm to z-axis <-130.000000> speed <20.000000>;
	turn l2Arm to z-axis <-130.000000> speed <20.000000>;
	turn l1Halt to z-axis <130.000000> speed <20.000000>;
	turn l2Halt to z-axis <130.000000> speed <20.000000>;
	sleep 2500;
	turn r2Klap to z-axis <130.000000> speed <15.000000>;
	turn l2Klap to z-axis <-130.000000> speed <15.000000>;
	turn r1Traeg to z-axis <135.000000> speed <35.000000>;
	turn r2Traeg to z-axis <135.000000> speed <35.000000>;
	turn r1Rot to z-axis <-145.000000> speed <35.000000>;
	turn r2Rot to z-axis <-145.000000> speed <35.000000>;
	sleep 500;
	turn l1Traeg to z-axis <-135.000000> speed <35.000000>;
	turn l2Traeg to z-axis <-135.000000> speed <35.000000>;
	turn l1Rot to z-axis <145.000000> speed <35.000000>;
	turn l2Rot to z-axis <145.000000> speed <35.000000>;
	wait-for-turn r1Traeg around z-axis;
	turn r1Halt to y-axis <-18.000000> speed <10.000000>;
	turn r2Halt to y-axis <18.000000> speed <10.000000>;
	turn r2Nano to y-axis <18.000000> speed <10.000000>;
	turn l1Halt to y-axis <18.000000> speed <10.000000>;
	turn l2Halt to y-axis <-18.000000> speed <10.000000>;
	turn l2Nano to y-axis <-18.000000> speed <10.000000>;
	signal 4;
	start-script Drehe();
	wait-for-turn r1Halt around y-axis;
}

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	while( TRUE )
	{
		healthpercent = get HEALTH;
		if( healthpercent < 66 )
		{
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )
			{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from r1Klap;
			emit-sfx smoketype from r3Klap;
			emit-sfx smoketype from l1Klap;
			emit-sfx smoketype from l3Klap;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

Freigabe()
{
	set YARD_OPEN to 1;
	while( !get YARD_OPEN )
	{
		set BUGGER_OFF to 1;
		sleep 1500;
		set YARD_OPEN to 1;
	}
	set BUGGER_OFF to 0;
}

Sperrung()
{
	set YARD_OPEN to 0;
	while( get YARD_OPEN )
	{
		set BUGGER_OFF to 1;
		sleep 1500;
		set YARD_OPEN to 0;
	}
	set BUGGER_OFF to 0;
}

Activate()
{
	while( Static_Var_2 )
	{
		sleep 200;
	}
	signal SIG_ACTIVATE;
	Static_Var_2 = 1;
	if( !Static_Var_3 )
	{
		call-script Oeffne();
		Static_Var_3 = 1;
	}
	call-script Freigabe();
	set INBUILDSTANCE to 1;
	Static_Var_2 = 0;
}

Deactivate()
{
	while( Static_Var_2 )
	{
		sleep 200;
	}
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	set INBUILDSTANCE to 0;
	sleep 2500;
	Static_Var_2 = 1;
	call-script Sperrung();
	if( Static_Var_3 )
	{
		call-script Schliesse();
		Static_Var_3 = 0;
	}
	Static_Var_2 = 0;
}

Create()
{
	dont-cache Blink1;
	dont-cache Blink2;
	dont-cache Spitze;
	dont-shade Rotor;
	dont-shade Basis;
	dont-shade r1Klap;
	dont-shade r2Klap;
	dont-shade r3Klap;
	dont-shade l1Klap;
	dont-shade l2Klap;
	dont-shade l3Klap;
	dont-shade r1Nano;
	dont-shade r2Nano;
	dont-shade r3Nano;
	dont-shade l1Nano;
	dont-shade l2Nano;
	dont-shade l3Nano;
	dont-shade r1Arm;
	dont-shade r2Arm;
	dont-shade l1Arm;
	dont-shade l2Arm;
	dont-shade r1Sch;
	dont-shade r2Sch;
	dont-shade l1Sch;
	dont-shade l2Sch;
	dont-shade r1Traeg;
	dont-shade r2Traeg;
	dont-shade l1Traeg;
	dont-shade l2Traeg;
	dont-shade r1Halt;
	dont-shade r2Halt;
	dont-shade l1Halt;
	dont-shade l2Halt;
	Static_Var_2 = 0;
	Static_Var_3 = 0;
	Static_Var_1 = 1;
	start-script SmokeUnit();
}

QueryNanoPiece(piecenum)
{
	if( Static_Var_1 == 1 )
	{
		piecenum = r1Spr;
	}
	if( Static_Var_1 == 2 )
	{
		piecenum = r2Spr;
	}
	if( Static_Var_1 == 3 )
	{
		piecenum = r3Spr;
	}
	if( Static_Var_1 == 4 )
	{
		piecenum = l1Spr;
	}
	if( Static_Var_1 == 5 )
	{
		piecenum = l2Spr;
	}
	if( Static_Var_1 == 6 )
	{
		piecenum = l3Spr;
	}
	++Static_Var_1;
	if( Static_Var_1 == 7 )
	{
		Static_Var_1 = 1;
	}
}

StartBuilding()
{
	dont-cache r1Blink;
	dont-cache r3Blink;
	dont-cache l1Blink;
	dont-cache l3Blink;
}

StopBuilding()
{
	cache r1Blink;
	cache r3Blink;
	cache l1Blink;
	cache l3Blink;
}

QueryBuildInfo(piecenum)
{
	piecenum = Rotor;
}

SweetSpot(piecenum)
{
	piecenum = Basis;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode Basis type BITMAPONLY | BITMAP1;
		explode r1Klap type BITMAPONLY | BITMAP1;
		explode r1Blink type BITMAPONLY | BITMAP1;
		explode r2Klap type BITMAPONLY | BITMAP1;
		explode r3Klap type BITMAPONLY | BITMAP1;
