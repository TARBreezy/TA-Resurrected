		explode l2Klap type BITMAPONLY | BITMAP1;
		explode l3Klap type BITMAPONLY | BITMAP1;
		explode l3Blink type BITMAPONLY | BITMAP1;
		explode r1Sch type BITMAPONLY | BITMAP1;
