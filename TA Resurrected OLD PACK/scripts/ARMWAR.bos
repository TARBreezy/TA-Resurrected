		if( !Moving_1 )
		{
			Ready_3 = 1;
			if( justmoved )
			{
				turn r_thigh to x-axis <0> speed <200.09>;
				turn rleg to x-axis <0> speed <200.09>;
				turn rfoot to x-axis <0> speed <200.09>;
