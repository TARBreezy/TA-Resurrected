#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  firept1, firept2, turret, gunbase, pelvis, lleg, rleg, gun1,
       gun2, ground;

static-var  Launcher_1;

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from turret;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
	return (0);
}

StartMoving()
{
	signal 2;
	set-signal-mask 2;
	while( TRUE )
	{
			move pelvis to y-axis [0] now;
			move lleg to y-axis [0] now;
			move lleg to z-axis [1.75] now;
			move rleg to y-axis [0] now;
			move rleg to z-axis [-1.60] now;
			turn pelvis to x-axis <5.97> now;
			turn lleg to x-axis <-5.97> now;
			turn rleg to x-axis <0> now;
			sleep 60;
			move pelvis to y-axis [-0.50] now;
			move lleg to y-axis [0.50] now;
			move rleg to y-axis [0.50] now;
			turn pelvis to x-axis <4.92> now;
			turn lleg to x-axis <-4.92> now;
			turn rleg to x-axis <1> now;
			sleep 30;
			move pelvis to y-axis [-0.30] now;
			move lleg to y-axis [0.30] now;
			move rleg to y-axis [0.30] now;
			turn pelvis to x-axis <2.11> now;
			turn lleg to x-axis <-2.11> now;
			turn rleg to x-axis <2.81> now;
			sleep 20;
			move pelvis to y-axis [-0.10] now;
			move lleg to y-axis [0.10] now;
			move rleg to y-axis [0.10] now;
			turn pelvis to x-axis <1> now;
			turn lleg to x-axis <-1> now;
			turn rleg to x-axis <3.16> now;
			sleep 10;
			move pelvis to y-axis [0] now;
			move lleg to y-axis [0] now;
			move rleg to y-axis [1.10] now;
			move rleg to z-axis [-1.85] now;
			turn pelvis to x-axis <0> now;
			turn lleg to x-axis <0> now;
			turn rleg to x-axis <0> now;
			sleep 60;
			move lleg to z-axis [1] now;
			move rleg to z-axis [-0.35] now;
			sleep 60;
			move lleg to y-axis [0] now;
			move lleg to z-axis [0] now;
			move rleg to z-axis [0] now;
			turn pelvis to x-axis <0> now;
			turn lleg to x-axis <0> now;
			turn rleg to x-axis <0> now;
			sleep 60;
			move lleg to z-axis [-0.60] now;
			move rleg to z-axis [0.85] now;
			turn rleg to x-axis <-9.14> now;
			sleep 100;
			move lleg to z-axis [-1.20] now;
			move rleg to y-axis [0] now;
			turn pelvis to x-axis <5.98> now;
			turn rleg to x-axis <-5.97> now;
			sleep 60;
			move pelvis to y-axis [-0.50] now;
			move lleg to y-axis [0.50] now;
			move rleg to y-axis [0.50] now;
			turn pelvis to x-axis <4.57> now;
			turn lleg to x-axis <0.70> now;
			turn rleg to x-axis <-4.92> now;
			sleep 30;
			move pelvis to y-axis [-0.30] now;
			move lleg to y-axis [0.30] now;
			move rleg to y-axis [0.30] now;
			turn pelvis to x-axis <2.11> now;
			turn lleg to x-axis <2.81> now;
			turn rleg to x-axis <-2.11> now;
			sleep 20;
			move pelvis to y-axis [-0.10] now;
			move lleg to y-axis [0.10] now;
			move rleg to y-axis [0.10] now;
			turn pelvis to x-axis <1> now;
			turn lleg to x-axis <2.46> now;
			turn rleg to x-axis <-1> now;
			sleep 10;
			move lleg to y-axis [1.10] now;
			move lleg to z-axis [-1.55] now;
			move rleg to y-axis [0] now;
			turn pelvis to x-axis <0> now;
			turn lleg to x-axis <0> now;
			turn rleg to x-axis <0> now;
			sleep 60;
			move lleg to z-axis [-0.70] now;
			move rleg to z-axis [0.20] now;
			sleep 60;
			move lleg to z-axis [0.45] now;
			move rleg to y-axis [0] now;
			move rleg to z-axis [-0.30] now;
			turn rleg to x-axis <0> now;
			sleep 60;
		move lleg to z-axis [1] now;
		move rleg to y-axis [0] now;
		move rleg to z-axis [-1.30] now;
		turn lleg to x-axis <-10.20> now;
		turn rleg to x-axis <0> now;
		sleep 100;
	}
	return (0);
}

StopMoving()
{
	signal 2;
	set-signal-mask 2;
	return (0);
}

Create()
{
	Launcher_1 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = pelvis;
	return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = turret;
	return (0);
}

QueryPrimary(piecenum)
{
	piecenum = Launcher_1;
	return (0);
}

RestoreAfterDelay()
{
	sleep 5000;
	set-signal-mask 0;
	turn turret to y-axis <0> speed <90>;
	turn gunbase to x-axis <0> speed <45>;

	return (0);
}

AimPrimary(heading, pitch)
{
	signal 4;
	set-signal-mask 0;
	set-signal-mask 4;
	turn turret to y-axis heading speed <225>;
	turn gunbase to x-axis ( <0> - pitch ) speed <150>;
	wait-for-turn turret around y-axis;
	wait-for-turn gunbase around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	if( !Launcher_1 )
	{
		Launcher_1 = 1;
		move gun1 to z-axis [-1.50] speed [25];
		wait-for-move gun1 along z-axis;
		move gun1 to z-axis [0] speed [0.75];
		return (0);
	}
		Launcher_1 = 0;
		move gun2 to z-axis [-1.50] speed [25];
		wait-for-move gun2 along z-axis;
		move gun2 to z-axis [0] speed [0.75];
	return (0);
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode firept1 type BITMAPONLY | BITMAP1;
		explode firept2 type BITMAPONLY | BITMAP2;
		explode ground type BITMAPONLY | BITMAP3;
		explode gun1 type BITMAPONLY | BITMAP4;
		explode gun2 type BITMAPONLY | BITMAP5;
		explode gunbase type BITMAPONLY | BITMAP1;
		explode lleg type BITMAPONLY | BITMAP2;
		explode pelvis type BITMAPONLY | BITMAP3;
		explode rleg type BITMAPONLY | BITMAP4;
		explode turret type BITMAPONLY | BITMAP5;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode firept1 type FALL | BITMAP1;
		explode firept2 type FALL | BITMAP2;
		explode ground type FALL | BITMAP3;
		explode gun1 type FALL | BITMAP4;
		explode gun2 type FALL | BITMAP5;
		explode gunbase type BITMAPONLY | BITMAP1;
		explode lleg type FALL | BITMAP2;
		explode pelvis type BITMAPONLY | BITMAP3;
		explode rleg type FALL | BITMAP4;
		explode turret type BITMAPONLY | BITMAP5;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode firept1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
		explode firept2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode ground type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
		explode gun1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode gun2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
		explode gunbase type BITMAPONLY | BITMAP1;
		explode lleg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode pelvis type BITMAPONLY | BITMAP3;
		explode rleg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
		explode turret type BITMAPONLY | BITMAP5;
		return (0);
	}
	explode firept1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP1;
	explode firept2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode ground type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode gun1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	explode gun2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP5;
	explode gunbase type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode lleg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
	explode pelvis type BITMAPONLY | BITMAP3;
	explode rleg type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP4;
	explode turret type BITMAPONLY | BITMAP5;
	return (0);
}