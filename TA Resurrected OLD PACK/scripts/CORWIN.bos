#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, fan, cradle;

static-var  Static_Var_1, Static_Var_2, Static_Var_3, Static_Var_4;


SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( TRUE )
	{
		healthpercent = ( get HEALTH );
		if( healthpercent < 66 )
		{
			smoketype = ( 256 | 2 );
			if( Rand(1,66) < healthpercent )
			{
				smoketype = ( 256 | 1 );
			}
			emit-sfx smoketype from base;
		}
		sleeptime = ( healthpercent * 50 );
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
	return (0);
}

Create()
{
	cache fan;
	cache cradle;
	dont-shade fan;
	dont-shade cradle;
	Static_Var_1 = 3640;
	Static_Var_2 = 1820;
	Static_Var_3 = 0;
	Static_Var_4 = 0;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	start-script SmokeUnit();
	return (0);
}

Activate()
{
		spin fan around z-axis speed Static_Var_2;
		turn cradle to y-axis Static_Var_3 speed Static_Var_1;
		Static_Var_4 = 1;
	return (0);
}

Deactivate()
{
		spin fan around z-axis speed <0>;
		turn cradle to y-axis Static_Var_3 speed <0>;
		Static_Var_4 = 0;
	return (0);
}

SetSpeed(the_speed)
{
	if( Static_Var_4 )
	{
		Static_Var_2 = the_speed;
		spin fan around z-axis speed the_speed;
	}
	return (0);
}

SetDirection(Func_Var_1)
{
	if( Static_Var_4 )
	{
		Static_Var_3 = Func_Var_1;
		turn cradle to y-axis Func_Var_1 speed Static_Var_1;
	}
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = base;
	return (0);
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		explode fan type BITMAPONLY | BITMAP2;
		explode cradle type BITMAPONLY | BITMAP3;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP1;
		explode fan type SHATTER | BITMAP2;
		explode cradle type BITMAPONLY | BITMAP3;
		return (0);
	}
	corpsetype = 3;
	if( severity <= 99 )
	{
		explode base type BITMAPONLY | BITMAP1;
		explode fan type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2;
		explode cradle type BITMAPONLY | BITMAP3;
		return (0);
	}
	explode base type BITMAPONLY | BITMAP1;
	explode fan type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode cradle type BITMAPONLY | BITMAP3;
	return (0);
}