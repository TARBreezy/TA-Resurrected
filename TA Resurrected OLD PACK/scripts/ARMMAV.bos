			}
			sleep 200;
		}
	}
	return (0);
}

Create()
{
	Open_1 = 0;
	Gun_2 = 0;
	Moving_3 = 0;
	Aiming_4 = 0;
	Busy_5 = 0;
	hide lgunbarrel;
	hide lgunshaft;
	hide lgunbase;
	hide rgunbarrel;
	hide rgunshaft;
	hide rgunbase;
	hide flare1;
	hide flare2;
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	spin flare1 around y-axis speed <100>;
	spin flare2 around y-axis speed <100>;
	start-script MotionControl();
	start-script SmokeUnit();
	return (0);
}

StartMoving()
{
	Moving_3 = 1;
	return (0);
}

StopMoving()
{
	Moving_3 = 0;
	return (0);
}

