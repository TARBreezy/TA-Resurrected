FirePrimary()
{
	if( !Gun_2 )
	{
		move rgunbarrel to y-axis [1] now;
		show flare1;
		sleep 150;
		hide flare1;
		move rgunbarrel to y-axis [0] speed [15];
	}
	if( Gun_2 )
	{
		move lgunbarrel to y-axis [1] now;
		show flare2;
		sleep 150;
		hide flare2;
		move lgunbarrel to y-axis [0] speed [15];
	}
	Gun_2 = ( !Gun_2 );
	return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = torso;
	return (0);
}

QueryPrimary(piecenum)
{
	piecenum = Gun_2;
	return (0);
}

SweetSpot(piecenum)
{
	piecenum = torso;
	return (0);
}

Killed(severity, corpsetype)
{
	hide flare1;
	hide flare2;
	explode torso type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	if( severity <= 25 )
	{
		corpsetype = 1;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		return (0);
	}
	corpsetype = 3;
	return (0);
}